/cloud/public/
/cloud/node_modules/
/cloud/.wrangler/
/cloud/.dev.vars
/cloud/.dev.vars.*
/cloud/.env
/cloud/.env.*

# Step 6: generated nonsecret CI configuration (never commit local overrides).
/cloud/wrangler.ci.toml
